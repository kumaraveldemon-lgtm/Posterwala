# ==============================================================================
# POSTERWALA ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE (Postgres, Auth, Storage)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Supabase Service Role Key (Keep secret! Used server-side for admin signed URLs & bypass RLS in webhook)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# RAZORPAY (Payments & Webhook)
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard -> Settings -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
# Webhook Secret configured under Razorpay Dashboard -> Webhooks -> Add New Webhook
# Endpoint: https://your-domain.vercel.app/api/webhooks/razorpay
# Secret should match this value:
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_key

# ------------------------------------------------------------------------------
# TRANSACTIONAL EMAIL (Optional)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_...
